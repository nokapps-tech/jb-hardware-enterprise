<?php

namespace {{livewireNamespace}}\{{modelNamePluralUpperCase}};

use {{modelNamespace}}\{{modelName}};
use Illuminate\View\View;
use Livewire\Component;
use Livewire\WithPagination;

class Index extends Component
{
    use WithPagination;

    public string $search = '';

    public function render(): View
    {
        # TODO: Add columns to search on with $search here
        ${{modelNamePluralLowerCase}} = {{modelName}}::orderBy('updated_at', 'desc')
            ->paginate();

        return view('livewire.{{modelView}}.index', [
            '{{modelNamePluralLowerCase}}' => ${{modelNamePluralLowerCase}},
            'i' => $this->getPage() * ${{modelNamePluralLowerCase}}->perPage(),
        ]);
    }

    public function delete({{modelName}} ${{modelNameLowerCase}})
    {
        ${{modelNameLowerCase}}->delete();

        return $this->redirectRoute('{{modelRoute}}.index', navigate: true);
    }
}
